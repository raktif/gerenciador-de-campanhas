{
  "name": "gerenciador-de-campanhas-de-rpg",
  "productName": "Gerenciador de Campanhas de RPG",
  "version": "0.0.1",
  "description": "Aplicativo desktop local-first para gerenciamento de campanhas de RPG.",
  "author": "Projeto Gerenciador de Campanhas de RPG",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "eslint": "10.9.0",
    "pnpm": "11.24.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
